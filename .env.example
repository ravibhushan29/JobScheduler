# Copy to .env and fill in. For a local (non-Docker) run everything is
# optional; values marked REQUIRED FOR DOCKER must be set for docker compose.
# Full reference with explanations: app/config.py

# --- Security --------------------------------------------------------------
# Accepted X-API-Key values, comma-separated (several allow zero-downtime rotation).
# Empty = no auth (local dev only). REQUIRED FOR DOCKER.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change-me
REDIS_PASSWORD=change-me          # REQUIRED FOR DOCKER
POSTGRES_PASSWORD=change-me       # REQUIRED FOR DOCKER (the compose Postgres container)
FLOWER_BASIC_AUTH=admin:change-me # REQUIRED FOR DOCKER, "user:password"

# --- Database --------------------------------------------------------------
# Multi-pod / production needs Postgres (compose sets this for you):
# DATABASE_URL=postgresql://jobs:password@db-host:5432/jobs?sslmode=require
# Default: a local SQLite file (single machine only)
# DATABASE_URL=sqlite:///data/scheduler.db
# AUTO_MIGRATE=true                 # false in compose/k8s: `python -m app.migrate` runs instead
# DB_POOL_SIZE=5                    # per process (Postgres)
# DB_MAX_OVERFLOW=5
# CELERY_RESULT_BACKEND=            # default: the same Postgres DB, or data/celery_results.db
# CELERY_RESULT_EXPIRES=86400       # seconds Celery keeps a task's live result
# JOB_RETENTION_DAYS=30             # days the job history keeps a finished job

# --- Broker ----------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CELERY_BROKER_URL=rediss://:password@host:6379/0                   # overrides the above
# CELERY_BROKER_URL=sentinel://:pw@s1:26379;sentinel://:pw@s2:26379   # Redis Sentinel (HA)
# REDIS_SENTINEL_MASTER=mymaster
# BROKER_VISIBILITY_TIMEOUT=300     # seconds before Redis re-delivers an un-acked message

# --- No-double-execution guarantees ---------------------------------------
# EXECUTION_LEASE_SECONDS=60        # a running job's lease; renewed every lease/3 s
# DUPLICATE_RECHECK_SECONDS=15      # how often a deferred duplicate re-checks
# MAX_WORKER_LOSS_RECOVERIES=3      # re-runs after worker crashes before FAILURE
# OUTBOX_REPUBLISH_AFTER_SECONDS=30 # re-publish recorded-but-unpublished jobs after this

# --- Scheduler -------------------------------------------------------------
# SCHEDULE_POLL_INTERVAL_SECONDS=5
# SCHEDULER_HEARTBEAT_FILE=/tmp/scheduler-heartbeat

# --- Tasks and queues ------------------------------------------------------
# FIFO_ENABLED=true
# DEFAULT_QUEUE_NAME=default
# LONG_TASK_QUEUE_NAME=long
# TASK_DEFAULT_MAX_RETRIES=3
# TASK_DEFAULT_RETRY_BACKOFF=5
# TASK_SOFT_TIME_LIMIT=300
# TASK_TIME_LIMIT=360

# --- Webhooks (5.0) ---------------------------------------------------------
# WEBHOOK_SIGNING_SECRET=change-me  # HMAC-SHA256 key for X-JobScheduler-Signature (set it!)
# WEBHOOK_ALLOWED_HOSTS=*.example.com,hooks.partner.com   # empty = any host
# WEBHOOK_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=8            # then the delivery is FAILED (~1 day of backoff)
# WEBHOOK_POLL_INTERVAL_SECONDS=2

# --- Keys, tenants, rate limits (5.0) ---------------------------------------
# API_KEY_CACHE_SECONDS=10          # a revoked managed key stops working within this
# DEFAULT_RATE_LIMIT_PER_MINUTE=0   # for keys without their own limit; 0 = unlimited
# TENANT_MAX_ACTIVE_SCHEDULES=0     # 0 = unlimited
# AUDIT_RETENTION_DAYS=365

# --- Observability (5.0) ----------------------------------------------------
# METRICS_ENABLED=true              # GET /metrics (Prometheus)
# METRICS_CACHE_SECONDS=10
# METRICS_WINDOW_SECONDS=300        # window for the "recent" metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # turns tracing on
# TRACING_ENABLED=false             # force tracing on/off

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=text                   # or json (compose/k8s use json)
# LOG_TO_FILE=true                  # compose/k8s force false (stdout only)
# LOG_DIR=logs

# --- docker compose only --------------------------------------------------
# API_PORT=8000  API_PORT_MAX=8001  # host ports for the API replicas
# API_REPLICAS=2  WORKER_REPLICAS=2  WORKER_LONG_REPLICAS=2  SCHEDULER_REPLICAS=2
# API_WORKERS=2  WORKER_CONCURRENCY=4  WORKER_LONG_CONCURRENCY=2
# FLOWER_PORT=5555
