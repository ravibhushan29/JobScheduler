{
  "name": "@jobscheduler/client",
  "version": "5.0.0",
  "description": "TypeScript client for the Job Scheduler API (v1): submit, wait, stream, schedules, workflows, webhook verification.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "openapi-typescript ../openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3"
  }
}
